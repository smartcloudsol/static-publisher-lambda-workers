{
  "name": "@smart-cloud/static-publisher-lambda-workers",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK application for bounded Static Publisher render, rewrite, and deploy-copy Lambda workers",
  "license": "MIT",
  "author": "Smart Cloud Solutions, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartcloudsol/static-publisher-lambda-workers.git"
  },
  "bugs": {
    "url": "https://github.com/smartcloudsol/static-publisher-lambda-workers/issues"
  },
  "homepage": "https://github.com/smartcloudsol/static-publisher-lambda-workers#readme",
  "keywords": [
    "aws-cdk",
    "aws-lambda",
    "static-publisher",
    "wordpress"
  ],
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "synth": "cdk synth --strict",
    "synth:ci": "cdk synth --strict --app 'node --import tsx test/fixtures/synth-app.ts' --output cdk.out.ci",
    "diff": "cdk diff",
    "deploy": "cdk deploy --strict --outputs-file cdk-outputs.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run format:check && npm run build && npm run lint && npm test"
  },
  "dependencies": {
    "aws-cdk-lib": "2.265.0",
    "cdk-nag": "2.38.2",
    "constructs": "10.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "aws-cdk": "2.1128.1",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
